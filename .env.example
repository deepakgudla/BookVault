PORT=8080
GIN_MODE=debug
CORS_ALLOWED_ORIGINS=*
APP_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=bookvault
DB_SSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=720h

AWS_REGION=ap-south-2
# Leave AWS credentials unset in AWS deployments and use an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bookvault-uploads
AWS_S3_ENDPOINT=http://localhost:4566
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_EVENT_QUEUE_NAME=bookvault-events
UPLOAD_PROVIDER=local

UPLOAD_PATH=/uploads
MAX_UPLOAD_SIZE=10485760